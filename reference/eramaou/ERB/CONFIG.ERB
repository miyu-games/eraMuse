	PRINT [13] 調教時フィルタ　　　　　 現在：
	CALL CONFIG_SHOW_FILTER_STATUS
	PRINTFORML [14] 自己紹介風キャラ設定表示 現在：\@ GETBIT(FLAG:5,11) ? ON # OFF \@
	PRINTFORML [15] 年齢/スリーサイズの表示  現在：\@ GETBIT(FLAG:5,12) ? ON # OFF \@/\@ GETBIT(FLAG:5,15) ? ON # OFF \@
	PRINT [16] 調教後の処女献上発生　　 現在：
	CALL CONFIG_VIRGIN_CONCEDED_STATUS
	PRINTFORM [17] 魔王のペニスの状態 　　　現在：
	PRINTFORML %GET_LOOK_INFO(0, "ペニスの状態")%
ELSEIF PAGE == 1
	PRINTFORML [18] 男子勇者許可 　　　　　　現在：\@ GETBIT(FLAG:8,0) ? 許可 # 禁止 \@
	PRINTFORML [19] 勇者出現時の素質表示　　 現在：\@ GETBIT(FLAG:8,1) ? ON # OFF \@
	PRINTFORML [20] 勇者の恋愛発展　　　　　 現在：\@ GETBIT(FLAG:8,2) ? 許可 # 禁止 \@
	PRINTFORML [21] 勇者のクエスト受注　　　 現在：\@ GETBIT(FLAG:8,3) ? 禁止 # 許可 \@
ENDIF
DRAWLINE
PRINT [100] 戻る  
PRINTL [101] 次のページ

INPUT
LOCAL = RESULT
IF LOCAL == 100
	RETURN 0
ELSEIF LOCAL == 101
	PAGE += 1
	PAGE %= 2
	GOTO PAGE_TOP
ELSEIF LOCAL >= 0 && LOCAL <= 10
	INVERTBIT FLAG:5,LOCAL
ELSEIF LOCAL >= 18 && LOCAL <= 21
	LOCAL:1 = LOCAL - 18
	INVERTBIT FLAG:8,LOCAL:1
ELSEIF LOCAL == 11
	FLAG:37 = !(FLAG:37)
ELSEIF LOCAL == 12
	FLAG:35 = !(FLAG:35)
ELSEIF LOCAL == 13
	CALL CONFIG_FILTER_SETTING
ELSEIF LOCAL == 14
	INVERTBIT FLAG:5,11
ELSEIF LOCAL == 15
	CALL CONFIG_AGE_SETTING
ELSEIF LOCAL == 16
	CALL CONFIG_VIRGIN_CONCEDED_SETTING
ELSEIF LOCAL == 17
	CALL CONFIG_PENIS_YOU_SETTING
ENDIF

GOTO PAGE_TOP




