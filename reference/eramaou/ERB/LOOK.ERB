	LOVE_ID = LOVE_SORT:LOVE_COUNT
	
	;愛情度が2以下の場合、何も表示されない
	SIF MAIN_LOVE:LOVE_ID <= 3
		CONTINUE
	
	IF LOVE_ID == 0
		CALL LOVE_LIKE_BASE
		SIF RESULT == 0
			CONTINUE
	ELSEIF LOVE_ID == 1
		PRINTFORM 魔王様
	ELSEIF LOVE_ID == 2
		PRINTFORM 民を救うこと
	ELSEIF LOVE_ID == 3
		PRINTFORM チ○ポ
	ELSEIF LOVE_ID == 4
		PRINTFORM 勃起
