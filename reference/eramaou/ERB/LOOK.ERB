	ELSEIF LOVE_ID == 54 && MAIN_LOVE:50 > 6
		PRINTFORM ショタペニス
	ELSEIF LOVE_ID == 54
		PRINTFORM 美少年
	ELSEIF LOVE_ID == 60 && MAIN_LOVE:50 > 6
		PRINTFORM 野良犬様
	ELSEIF LOVE_ID == 60
		PRINTFORM いぬ
	ELSEIF LOVE_ID == 61 && MAIN_LOVE:50 > 6
		PRINTFORM 動物との交尾
	ELSEIF LOVE_ID == 61
		PRINTFORM モフモフ
	ELSEIF LOVE_ID == 62
		PRINTFORM 狂王様
	ELSE
		CONTINUE
	ENDIF
	
	;5個ごとにハートが一つずつ増える
	HEART = (MAIN_LOVE:LOVE_ID / 5) -1
	;ハートの数最大値は6個
	SIF HEART > 6
		HEART = 6
	SIF HEART > 0
		PRINTFORM %UNICODE(0x2661) *HEART%
	
	;間の空白
	PRINT 　
	
	;好きな数を増やす
	LOVE_NUM++
	
	;改行
	IF LOVE_NUM % 6 == 0
		PRINTL  
		PRINT 　
	ENDIF
NEXT

IF FLAG:5 & 2048
	;喜び
	CALL GOBI_KOUJO, 1
	
	PRINTL 」 
ELSE
	PRINTL  
ENDIF

PRINTFORML [{LOVE_NUM}個の好きなものがあります]

RETURN 1

