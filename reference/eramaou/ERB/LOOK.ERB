	ELSEIF LOVE_ID == 33
		PRINTFORM 虐められること
	ELSEIF LOVE_ID == 34
		PRINTFORM 虐めること
	ELSEIF LOVE_ID == 35
		PRINTFORM 露出すること
	ELSEIF LOVE_ID == 40
		PRINTFORM 夫
	ELSEIF LOVE_ID == 40  && TALENT:オトコ
		PRINTFORM 妻
	ELSEIF LOVE_ID == 41
		PRINTFORM 今の夫
	ELSEIF LOVE_ID == 41  && TALENT:オトコ
		PRINTFORM 今の妻
	ELSEIF LOVE_ID == 42
		;恋人無し
		IF LOVER == 0 && TALENT:オトコ
			PRINTFORM 未来の妻
		ELSEIF LOVER == 0
			PRINTFORM 未来の旦那様
		ELSEIF LOVER == 200
			PRINTFORM 恋人
		ELSE
			PRINT 恋人の
			CALL NAME_LOVER,LOVER,1
		ENDIF
	ELSEIF LOVE_ID == 50
		;コンプレックスは強化ソースなので表示はしない
		CONTINUE
	ELSEIF LOVE_ID == 51 && MAIN_LOVE:50 > 6
		PRINTFORM 人妻
	ELSEIF LOVE_ID == 51
		PRINTFORM お母さん
	ELSEIF LOVE_ID == 52 && MAIN_LOVE:50 > 6
		PRINTFORM 中年オヤジ
	ELSEIF LOVE_ID == 52
		PRINTFORM お父さん
	ELSEIF LOVE_ID == 53 && MAIN_LOVE:50 > 6
		PRINTFORM ロリマ○コ
	ELSEIF LOVE_ID == 53
