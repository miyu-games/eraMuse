;-----------------------------------------
@MONSTER_PLAY_CALC,ARG:0,ARGS
#DIM PLAY
;-----------------------------------------

;経験人数・獲得リソース
PLAY = 1
;素質を見る

IF ARGS == "獣姦"
	;動物耳
	SIF TALENT:(ARG:0):動物耳
		PLAY += 1
	;牝犬
	SIF TALENT:(ARG:0):牝犬
		PLAY += 3
	;獣姦中毒
		PLAY += ABL:(ARG:0):獣姦中毒

	;特殊な経験の有無
	;獣姦経験
	SIF EXP:(ARG:0):獣姦経験
		PLAY += 1
	;50回を超える獣姦経験
	SIF EXP:(ARG:0):獣姦経験 > 50
		PLAY += 3

	;常識改変効果
	;獣姦マニア
	SIF TALENT:(ARG:0):283 == 5
		PLAY += 3
ENDIF

IF ARGS == "奉仕" || ARGS == "全穴"
	;献身的（奉仕）
	SIF TALENT:(ARG:0):献身的
		PLAY += 1
	;奉仕しない（奉仕減少）
	SIF TALENT:(ARG:0):奉仕しない
		PLAY -= 20
	;奉仕精神（奉仕）
		PLAY += ABL:(ARG:0):奉仕精神
	;奉仕快楽経験（奉仕）
	SIF EXP:(ARG:0):奉仕快楽経験
		PLAY += 1
	;物乞い奉仕（奉仕）
	SIF TALENT:(ARG:0):283 == 1
		PLAY += 3
ENDIF

IF ARGS == "前穴" || ARGS == "両穴" || ARGS == "全穴"
	;セックス狂（V）
	SIF TALENT:(ARG:0):セックス狂
		PLAY += 3
	;淫壷（V）
	SIF TALENT:(ARG:0):淫壷
		PLAY += 3
	;V感覚（V）
		PLAY += ABL:(ARG:0):Ｖ感覚
	;V拡張経験（V）
	SIF EXP:(ARG:0):Ｖ拡張経験
		PLAY += 1
ENDIF

IF ARGS == "アナル" || ARGS == "両穴" || ARGS == "全穴"
	;尻穴狂い（A）
	SIF TALENT:(ARG:0):尻穴狂い
		PLAY += 3
	;淫肛（A）
	SIF TALENT:(ARG:0):淫肛
		PLAY += 3
	;A感覚（A）
		PLAY += ABL:(ARG:0):Ａ感覚
	;A拡張経験（A）
	SIF EXP:(ARG:0):Ａ拡張経験
		PLAY += 1
	IF ARGS == "アナル"
		;処女封印（V減少）
		SIF TALENT:(ARG:0):処女封印
			PLAY += 1
		;処女（V減少）
		SIF TALENT:(ARG:0):処女
			PLAY += 1
	ENDIF
ENDIF

;素質

;貞操無頓着
SIF TALENT:(ARG:0):貞操無頓着
	PLAY += 1
;快感に素直
SIF TALENT:(ARG:0):快感に素直
	PLAY += 1
;淫乱
SIF TALENT:(ARG:0):淫乱
	PLAY += 1

;能力

;従順
	PLAY += ABL:(ARG:0):従順
;欲望
	PLAY += ABL:(ARG:0):欲望
;技巧
	PLAY += ABL:(ARG:0):技巧

;常識改変効果
;公衆便女
SIF TALENT:(ARG:0):283 == 4
	PLAY += 3

;ランダムボーナス
	PLAY += RAND:2

SIF PLAY <= 0
	PLAY = 1

RETURN PLAY


