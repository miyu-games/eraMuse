;eraIM@Sから導入しました(eramaou)

;-------------------------------------------------
;母乳売却
;-------------------------------------------------
@SELL_MILK

SIF TARGET < 0 || TARGET > CHARANUM
	RETURN 0

A = TFLAG:35 * 100
O = A * 5
IF A > 0
	DRAWLINE

	IF EXP:54 <= EXPLV:3
		TIMES O , 1.00
	ELSEIF EXP:54 <= EXPLV:4
		TIMES O , 1.20
	ELSEIF EXP:54 <= EXPLV:5
		TIMES O , 1.50
	ELSE
		TIMES O , 2.00
	ENDIF

	;処女なら売却額三倍
	SIF TALENT:0
		O = O * 3
	;乳狂いなら売却額ニ倍
	SIF TALENT:78
		O = O * 2

	PRINTFORML 搾乳器を使って%SAVESTR:TARGET%から{A}ccの母乳を搾り出した。
	IF ASSI > 0
		IF ABL:ASSI:15
			PRINTFORML %SAVESTR:ASSI%の巧みな加工で、%SAVESTR:TARGET%の母乳は通常より高く売れた。
			O *= 100 + ABL:ASSI:15 * 5
			O /= 100
		ENDIF
	ENDIF
	PRINTFORML %SAVESTR:TARGET%の母乳には{O}ポイントの買値が付いた。
	MONEY += O
	PRINTFORML 所持金 {O}ポイント増加
	WAIT
ENDIF

RETURN 0
