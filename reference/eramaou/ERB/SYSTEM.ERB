	RESULT += 1
	SIF RESULT > 0
		HEAL *= RESULT
	
	;装備効果
	W:8 = 13
	CALL EQUIP_CHECK
	RESULT += 1
	SIF RESULT > 0
		HEAL /= RESULT
	
