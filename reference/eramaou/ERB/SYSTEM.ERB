	W:8 = 15
	CALL EQUIP_CHECK
	IF RESULT > 0 && CFLAG:A:1 == 2
		CFLAG:A:1 = 0
		PRINTFORMW %SAVESTR:A%は虚ろな目であなたに傅いた
