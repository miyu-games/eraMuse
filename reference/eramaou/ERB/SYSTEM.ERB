	IF CFLAG:A:503 & 1
		HEAL *= 2
		CFLAG:A:503 -= 1
	ENDIF
	CFLAG:A:4 = 0
	
	;回復早い、回復遅い、虚弱
	IF TALENT:A:111
		HEAL *= 2
	ELSEIF TALENT:A:112 || TALENT:A:256
		HEAL /= 2
	ENDIF

