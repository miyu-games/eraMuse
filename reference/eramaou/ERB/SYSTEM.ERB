				ELSEIF TALENT:A:302 == 201
					PRINTL 髪は腰まで伸び、ロングになった。
				ENDIF
			ENDIF
		ENDIF
		;TALENT:310 == TALENT:311 のとき、成長が止まる
		IF TALENT:A:310 < TALENT:A:311 && TALENT:A:125 == 0 && TALENT:A:310 <= 200
			TALENT:A:310 += 1
