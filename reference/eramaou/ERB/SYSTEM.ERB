		PRINTFORMW %SAVESTR:A%は虚ろな目であなたに傅いた
		ABL:A:10 += 1
	ENDIF
	
	;好感度減少
	IF CFLAG:A:1 == 2 && CFLAG:A:2 > 100
		CFLAG:A:2 -= RAND:100
	ENDIF
	
