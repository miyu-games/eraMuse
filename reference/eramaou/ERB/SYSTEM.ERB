FOR LEADER, 0, CHARANUM
	;装備の回復
	CALL WEAPON_RESTORE,LEADER
	
	;ダンジョン攻略
	SIF CFLAG:LEADER:1 == 12
		CALL DUNGEON, LEADER
NEXT

A = 1
REPEAT CHARANUM
	SIF A >= CHARANUM
		BREAK
	
	;キャンペーン終了後のリセット
	IF FLAG:400 == 0 && CFLAG:A:1 == 12
		CFLAG:A:1 = 0
		CFLAG:A:534 = 0
	ENDIF
	
	;ダンジョン攻略
	IF (CFLAG:A:1 == 2 || CFLAG:A:1 == 3) && FLAG:502 == 0
		
		LEADER = A
		
		CALL DUNGEON, LEADER
		
		A = LEADER
		
	ELSEIF CFLAG:A:1 == 2 || CFLAG:A:1 == 3
		;フィールド
		CALL DUNGEON_MAP
	ENDIF
	
	SIF CFLAG:A:1 != 2
		CALL LVUP, A
	
	;戦果
	CALL DUNGEON_AFTER
	
	;体力の回復（午後の調教後は夜の休みが入るので回復大きい）
	SIF BASE:A:0 < 1
		BASE:A:0 = 1
	
