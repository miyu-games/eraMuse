			X += 100 + RAND:5
			IF CFLAG:A:501 >= 8 && RAND:10 == 0
				Z = 191 + RAND:3
				SIF ITEM:Z > 0
					X = Z
			ENDIF
			CFLAG:A:570 = X
		ENDIF
	ELSEIF TALENT:A:265
		;使役。パートナーがいない場合、ランダムで取得する
		;階層が低いほど確率が高い
		IF CFLAG:A:570 == 0
			FOR X,0,9
				SIF RAND:3 == 0
					BREAK
			NEXT
			SIF X > 8
				X = 8
			X *= 10
			X += 100 + RAND:5
			;ごく稀に超強い使役
			SIF RAND:50 == 0
				X = 191 + RAND:3
			CFLAG:A:570 = X
		ENDIF
	ELSE
		CFLAG:A:570 = 0
	ENDIF
	
