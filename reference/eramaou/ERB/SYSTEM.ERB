		IF TALENT:A:12
			MHEAL *= 2
		ELSEIF TALENT:A:10
			MHEAL /= 2
		ENDIF
		
		BASE:A:1 += MHEAL
		SIF BASE:A:1 > MAXBASE:A:1
			BASE:A:1 = MAXBASE:A:1
		
	ELSE
		BASE:A:1 = MAXBASE:A:1
	ENDIF
	
