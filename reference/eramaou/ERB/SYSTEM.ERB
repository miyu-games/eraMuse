		FLAG:500 = RESULT
	
ELSEIF RESULT == 2
	;初期奴隷
	PRINTL [0] ランダム  [1] 村娘
	INPUT
	
	SIF RESULT >= 0 && RESULT <= 1
		FLAG:501 = RESULT
	
ELSEIF RESULT == 3
	;モード
	PRINTL [0] 通常  [1] 2D
	INPUT
	
	SIF RESULT >= 0 && RESULT <= 1
		FLAG:502 = RESULT
	
ELSEIF RESULT == 100
	RETURN 0
ELSE
	GOTO INPUT_LOOP
ENDIF

GOTO INPUT_LOOP

