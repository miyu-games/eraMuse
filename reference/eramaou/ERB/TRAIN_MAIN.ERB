;=================================================
;BEGIN TRAIN後最初に呼び出される関数
;=================================================
@EVENTTRAIN
#PRI
;主人公の射精を0に
BASE:MASTER:2 = 0
;いちおう調教対象と助手も
BASE:TARGET:2 = 0
SIF ASSI >= 0
	BASE:ASSI:2 = 0
BASE:TARGET:3 = 0
BASE:MASTER:4 = 0

;射精フラグ、処女喪失フラグなどをリセット
VARSET TFLAG, 0, 0, 201

;前回の調教テキストを空に
;TSTR:90 = 　

;調教者は誰か
IF ASSIPLAY == 0
	PLAYER = MASTER
ELSE
	PLAYER = ASSI
ENDIF

;常時発情ボーナス：潤滑と欲情が3000からスタート
IF TALENT:TARGET:271
	PALAM:TARGET:3 = 3000
	PALAM:TARGET:5 = 3000
ENDIF

;コロシアムの収入初期化
TFLAG:402 = 0

CALL PRITRAIN_MESSAGE

;=================================================
;EVENTTRAINの後に毎ターン呼び出される関数
;=================================================
@SHOW_STATUS
DRAWLINE
PRINTV DAY+1
PRINT 日目
IF TIME == 0
	PRINTL (午前)
ELSE
	PRINTL (午後)
ENDIF
PRINTFORM %SAVESTR:TARGET% 調教中   調教者:
IF ASSIPLAY
	SETCOLOR 0xFF1493
	PRINTS SAVESTR:ASSI
	PRINT (助手)
	resetcolor
ELSE
	SETCOLOR 0x87CEFA
	PRINTS NAME:MASTER
	RESETCOLOR
ENDIF
SIF ASSI  > 0 && ASSIPLAY == 0
	PRINTFORM   助手:%SAVESTR:ASSI%
PRINT   

CALL SHOW_EQUIP_2
CALL LIFE_BAR
CALL VITAL_BAR
;調教時ステータス画面に服装表示を捻じ込んでみた
;同様のやり方で下着を個別指定にすれば捗ると思います（
PRINT 【
CALL PRINT_CLOTHTYPE
PRINT 】

PRINTL 

SIF EX:0 > 0
	PRINTFORM [Ｃ絶頂：{EX:0}]  
SIF EX:1 > 0
	PRINTFORM [Ｖ絶頂：{EX:1}]  
SIF EX:2 > 0
	PRINTFORM [Ａ絶頂：{EX:2}]  
SIF EX:3 > 0
	PRINTFORM [Ｂ絶頂：{EX:3}]  
SIF EX:4 > 0
	PRINTFORM [%CSTR:7%絶頂：{EX:4}]  
SIF EX:5 > 0
	PRINTFORM [噴乳：{EX:5}]  
SIF EX:0 || EX:1 || EX:2 || EX:3 || EX:4 || EX:5
	PRINTL  

PRINT_PALAM TARGET

SIF MAXBASE:2 == 0
	MAXBASE:2 = 10000
SIF MAXBASE:2 != 5000 && TALENT:133 && (TALENT:121 || TALENT:122)
	MAXBASE:2 = 5000
SIF MAXBASE:MASTER:2 == 0
	MAXBASE:MASTER:2 = 10000
SIF MAXBASE:MASTER:2 != 5000 && TALENT:MASTER:133 && (TALENT:MASTER:121 || TALENT:MASTER:122)
	MAXBASE:MASTER:2 = 5000
IF ASSI >= 0
	IF MAXBASE:ASSI:2 == 0
		MAXBASE:ASSI:2 = 10000
	ELSEIF MAXBASE:ASSI:2 != 0 && TALENT:ASSI:133 && (TALENT:ASSI:121 || TALENT:ASSI:122)
		MAXBASE:ASSI:2 = 5000
	ENDIF
ENDIF

IF (TALENT:MASTER:121 || TALENT:MASTER:122) && TALENT:MASTER:135 == 0
	PRINT 射精
	BAR BASE:MASTER:2,MAXBASE:MASTER:2,32
	PRINTFORM ({BASE:MASTER:2}/{MAXBASE:MASTER:2})
	SIF TEQUIP:35
		PRINT コンドーム装着
	PRINTL 
ENDIF

IF ASSIPLAY
	IF (TALENT:ASSI:121 || TALENT:ASSI:122) && TALENT:ASSI:135 == 0
		PRINT 射精（助手）
		BAR BASE:ASSI:2,MAXBASE:ASSI:2,32
		PRINTFORM ({BASE:ASSI:2}/{MAXBASE:ASSI:2})
		SIF TEQUIP:36
			PRINT コンドーム装着
		PRINTL 
	ENDIF
ENDIF

IF (TALENT:TARGET:121 || TALENT:TARGET:122) && TALENT:TARGET:135 == 0
	PRINT 射精（
	PRINTS SAVESTR:TARGET
	PRINT ）
	BAR BASE:2,MAXBASE:2,32
	PRINTFORM ({BASE:2}/{MAXBASE:2})
	SIF TEQUIP:37
		PRINT コンドーム装着
	PRINTL 
ENDIF

IF TALENT:TARGET:130
	SIF MAXBASE:3 == 0
		MAXBASE:3 = 10000
	PRINT 母乳（
	PRINTS SAVESTR:TARGET
	PRINT ）
	BAR BASE:3,MAXBASE:3,32
	PRINTFORML ({BASE:3}/{MAXBASE:3})
ENDIF

IF TEQUIP:89
	SIF MAXBASE:MASTER:4 == 0
		MAXBASE:MASTER:4 = 10000
	PRINT 射精（犬）
	BAR BASE:MASTER:4,MAXBASE:MASTER:4,32
	PRINTFORML ({BASE:MASTER:4}/{MAXBASE:MASTER:4})
ENDIF

IF TEQUIP:90
	SIF MAXBASE:MASTER:4 == 0
		MAXBASE:MASTER:4 = 10000
	PRINT 射精（触手）
	BAR BASE:MASTER:4,MAXBASE:MASTER:4,32
	PRINTFORML ({BASE:MASTER:4}/{MAXBASE:MASTER:4})
ENDIF

IF TEQUIP:55
	SIF MAXBASE:MASTER:4 == 0
		MAXBASE:MASTER:4 = 10000
	PRINT 射精（コロシアム・モンスター）
	BAR BASE:MASTER:4,MAXBASE:MASTER:4,32
	PRINTFORML ({BASE:MASTER:4}/{MAXBASE:MASTER:4})
ENDIF
CALL SHOW_EQUIP_1

;=================================================
;TRAINでコマンド選択時最初に呼び出されるイベント関数
;=================================================
@EVENTCOM
#PRI
;TFLAG:0～30はコマンドを選択する度に空にする
REPEAT 30
	TFLAG:COUNT = 0
REND
TFLAG:100 = 0

;=================================================
;TRAINでコマンド選択終了後に呼び出される関数
;=================================================
@EVENTCOMEND
#PRI
;調教キャラの死亡・衰弱判定
IF BASE:0 <= 0
	DRAWLINE
	;死亡時にビデオを使用していた？
	SIF TEQUIP:53
		TFLAG:34 = 1
	PRINTFORML %SAVESTR:TARGET%がぴくりとも動かなくなった
	PRINTFORML 何をやっても反応がない……
	WAIT
	BEGIN AFTERTRAIN
;瀕死時に調教を自動終了設定
ELSEIF BASE:0 < 500 && FLAG:35 == 1
	DRAWLINE
	PRINTL （体力が限界に来ています。調教を終了します）
	WAIT
	BEGIN AFTERTRAIN
ENDIF

IF ASSI > 0
	IF BASE:ASSI:0 <= 0
		DRAWLINE
		;死亡時にビデオを使用していた？
		SIF TEQUIP:53
			TFLAG:34 = 1
		PRINTFORML %SAVESTR:ASSI%がぴくりとも動かなくなった
		PRINTFORML 何をやっても反応がない……
		WAIT
		BEGIN AFTERTRAIN
	;瀕死時に調教を自動終了設定
	ELSEIF BASE:ASSI:0 < 500
		DRAWLINE
		PRINTL （助手の体力が限界に来ています。調教を終了します）
		WAIT
		BEGIN AFTERTRAIN
	ENDIF
ENDIF

;=================================================
;BEGIN AFTERTRAIN後最初に呼び出される関数
;=================================================
@EVENTEND
#LATER
PRINTL 調教を終了しました。
WAIT

;失神時の口上非表示の回復
IF TFLAG:860 == 1
	FLAG:7 = 1
	TFLAG:860 = 0
ELSEIF TFLAG:860 == 2
	FLAG:7 = 2
	TFLAG:860 = 0
ENDIF

;今回の調教対象と助手を記録
FLAG:1 = TARGET
FLAG:2 = ASSI

;調教後に死んでいる可能性をチェック
CALL CHARADEAD_CHECK

;生きていれば調教後行為のチェック
IF RESULT == 0
	CALL SELF_CHECK
	DRAWLINE
ENDIF

;搾乳した母乳の売却
CALL SELL_MILK

;調教時に録画したビデオを売却
CALL SELL_VIDEO

;コロシアムの観戦料
CALL SELL_FIGHTMONEY

;生きていて着衣モードなら調教後の衣類の処理
IF FLAG:37 && BASE:0 > 0
	CALL AFTERTRAIN_CLOTH
	;衣類の再着衣
	CALL RE_CLOTHED
ENDIF

;調教後に死ぬか臨死状態なら珠を獲得せずに、ターゲットを空にしてターン終了
IF BASE:0 < 1
	;キャラ削除処理
	A = TARGET

	X = NO:A + 199
	FLAG:X = 1

	TARGET = -1
	FLAG:1 = -1
	ASSI = -1
	
	CALL PARTY_CHAR_DEL, A

	DELCHARA A

	CALL NAME_RESET

	BEGIN TURNEND
ENDIF

;カルマ増減
IF EX:1
	PRINTW (V絶頂によりカルマが下がりました:-1)
	CALL KARMA, TARGET, -1
ENDIF

IF EX:2
	PRINTW (A絶頂によりカルマが下がりました:-2)
	CALL KARMA, TARGET, -2
ENDIF

;常時発情
IF FLAG:75 == 0 && TALENT:271 == 0
	;潤滑の10000分の1を蓄積　潤滑が10000を下回る場合はリセット
	IF PALAM:3 >= 10000
		CFLAG:81 += PALAM:3 / 10000
	ELSE
		CFLAG:81 = 0
	ENDIF
	;欲情の10000分の1を蓄積　欲情が10000を下回る場合はリセット
	IF PALAM:5 >= 10000
		CFLAG:82 += PALAM:5 / 10000
	ELSE
		CFLAG:82 = 0
	ENDIF
ENDIF

LOCAL = 0
IF FLAG:400 && TALENT:85
	PRINT *奴隷の愛により気力回復*
	LOCAL = 700
ELSEIF FLAG:400
	PRINT *奴隷調教より気力回復*
	LOCAL = 500
ENDIF
BASE:0:1 += LOCAL
SIF BASE:0:1 > MAXBASE:0:1
	BASE:0:1 = MAXBASE:0:1

;何の珠を得られたか
CALL JUEL_CHECK

;能力値の上昇はメイン画面で行わせる
BEGIN TURNEND
