REPEAT 31
	ARG:99 = COUNT + 59
	IF ARG:98 >= 5
		PRINTFORML 　
		ARG:98 = 0
	ENDIF
	IF ITEM:(ARG:99) > 0
		SIF ARG:98 == 0
			PRINT  
		PRINT 　
		PRINTFORM %ITEMNAME:(ARG:99) + @"({ITEM:(ARG:99)})",18,LEFT%
		ARG:98 += 1
	ENDIF
REND
PRINTL  
SETFONT

RETURN

;-------------------------------------------------------------------------------
;    ダンジョンの状況概要
;-------------------------------------------------------------------------------
;===============================================================================
@DRAW_DUNGEON_OVERVIEW
#DIM DYNAMIC TEMP, 500
#DIM DYNAMIC TEMP1, 100
PRINT 　 
PRINTFORML ダンジョンLv： {CFLAG:0:9}Lv (経験値： {EXP:0:80})　　罠Lv：{FLAG:85}Lv　　現在の勇者初期Lv： {FLAG:60 + 1}Lv
REPEAT 99
	TEMP:COUNT = 0
REND

SETFONT "ＭＳ ゴシック";等幅フォントに
IF CHARANUM >= 1
	REPEAT CHARANUM
		;主人公は排除
		SIF COUNT == 0
			CONTINUE
			;RETURN 0
		;ダンジョン内に居ない子は排除
		IF CFLAG:COUNT:1 == 2 || CFLAG:COUNT:1 == 3
			IF CFLAG:COUNT:1 == 2
				IF CFLAG:COUNT:501 <= 1 && CFLAG:COUNT:502 == 0
					TEMP:10 += 1
				ELSE
					TEMP:(CFLAG:COUNT:501) += 1
				ENDIF
				TEMP:97 += 1
			ENDIF
			
			IF CFLAG:COUNT:1 == 3
				D = (CFLAG:COUNT:501) + 10
				TEMP:D += 1
				TEMP:96 += 1
			ENDIF
		ELSE
			CONTINUE
		ENDIF
	REND
ENDIF	
	
	
	B = 0
	C = 0
	D = 0
	Z = 0
	R = 100

		REPEAT 100
		SIF Z >= 100 || R <= 0
			BREAK
			
		Y = Z % 10
		IF Y == 0
			X = Z / 10
			X += 1
			D = X + 10
			TEMP1:4 += 1
			FONTBOLD
			IF X != 10 && TEMP1:4 == 1
				PRINT 　 
				PRINTFORM 第{X}階層：　　　　　　　　　　　　　　　　　　　　　 
				SIF X+1 != 10
				PRINTFORM 第{X+1}階層：
				PRINTFORML 
			ELSEIF X == 10
;				PRINT 　 
;				PRINTFORM 近衛兵：
			ELSE
				TEMP1:4 = 0
			ENDIF
			FONTREGULAR
		ENDIF
		
		A = Z + 100
		B += ITEM:A
		C += ITEM:A
		Z += 1
		R -= 1

		Y = Z % 10
		IF Y == 0
			TEMP1:2 = X + 349
			TEMP1:3 = FLAG:(TEMP1:2)
			
			IF X != 10
				SIF TEMP1:4 == 1
					PRINT 　  
				PRINTFORM 部下{B, 4}体, 
				SIF TEMP:X >= 1
					SETCOLOR 0xFFFF00
				PRINTFORM 勇者：{TEMP:X, 2}人
				RESETCOLOR
				PRINTFORM , 
				SIF TEMP:D >= 1
					SETCOLOR 0x64A0FF
				PRINTFORM 迎撃：{TEMP:D, 2}人　
				RESETCOLOR
				PRINTFORM 施設：
				IF TEMP1:3 == 500
					PRINTFORM 商店街　
				ELSEIF TEMP1:3 == 501
					PRINTFORM 沼地　　
				ELSEIF TEMP1:3 == 502
					PRINTFORM 人間牧場
				ELSEIF TEMP1:3 == 503
					PRINTFORM 氷室　　
				ELSEIF TEMP1:3 == 504
					PRINTFORM 熱砂　　
				ELSEIF TEMP1:3 == 505
					PRINTFORM 迷宮　　
				ELSEIF TEMP1:3 == 506
					PRINTFORM 博物館　
				ELSEIF TEMP1:3 == 507
					PRINTFORM 娼館街　
				ELSE
					PRINTFORM 無し　　
				ENDIF
				SIF TEMP1:4 == 1
					PRINT 　　 

			ELSEIF X == 10
				PRINTFORM 近衛兵：
				PRINTFORML {B, 4}体, ダンジョン外の勇者：{TEMP:10, 2}人　
			ENDIF
			B = 0
			TEMP:98 += 1

			IF TEMP:98 >= 2 && TEMP1:5 != 4
				PRINTFORML 
				TEMP:98 = 0
				TEMP1:5 += 1
			ENDIF
		ENDIF
	REND
PRINT 　
PRINTFORM 部下総計：{C, 5}体, 勇者総計：{TEMP:97, 2}人, 迎撃総計：{TEMP:96, 2}人, 肉便器：{FLAG:83, 5}台, 調度品：{FLAG:84, 5}個
;CALL DUNGEON_FINAL_BATTLE, 1
;SIF RESULT >= 1
;	PRINTFORM 魔王部屋迎撃可能
PRINTL  
SETFONT
RETURN 0
