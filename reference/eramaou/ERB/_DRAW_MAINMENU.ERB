@DRAW_MAINMENU
#Dim TEMP, 300

;バグ対策
SIF TARGET > CHARANUM - 1
	TARGET = -1

;バグ対策
SIF ASSI > CHARANUM - 1
	ASSI = -1

;バグ対策
SIF ASSI == TARGET
	ASSI = -1

