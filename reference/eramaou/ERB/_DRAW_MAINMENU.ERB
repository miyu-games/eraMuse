ELSE
	CALL MENU_BUTTON, 1, @"%UNICODE(0x258c)%Target", 496
ENDIF
PRINT 　　　　　　　　　　　　　　　　　
;下記PRINTは仮調整用
PRINT 　　　　　　　　　　　　　　　
