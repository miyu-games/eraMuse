ENDIF
PRINT 　
IF A > 0
	PRINTFORM %"[103] 処刑", 18, LEFT%
ELSE
	PRINTFORM %"[---] 　　", 18, LEFT%
ENDIF
PRINT 　
IF A > 0
	PRINTFORM %"[104] 迎撃", 18, LEFT%
ELSE
	PRINTFORM %"[---] 　　", 18, LEFT%
ENDIF
PRINT 　
;IF A > 0
	PRINTFORML %"[105] 能力値アップ", 18, LEFT%
;ELSE
;	PRINTFORML %"[---] 　　　　　　", 18, LEFT%
;ENDIF
PRINT 　
IF B > 0
	PRINTFORM %"[106] 奴隷売却", 18, LEFT%
ELSE
	PRINTFORM %"[---] 　　　　", 18, LEFT%
ENDIF
PRINT 　
	PRINTFORM %"[107] 購入", 18, LEFT%
PRINT 　
IF A > 0 && FLAG:37 == 1
	PRINTFORML %"[108] 着替え", 18, LEFT%
ELSE
	PRINTFORML %"[---] 　　　", 18, LEFT%
ENDIF
PRINT 　
	PRINTFORM %"[109] 侵攻", 18, LEFT%
PRINT 　
IF TALENT:0:325 == 1
	PRINTFORM %"[110] 実験室", 18, LEFT%
ELSE
	PRINTFORM %"[---] 　　　", 18, LEFT%
ENDIF
PRINT 　
IF FLAG:83 || FLAG:84
	PRINTFORML %"[111] 施設・設備", 18, LEFT%
ELSE
	PRINTFORML %"[---] 　　　　　", 18, LEFT%
ENDIF
PRINT 　
	PRINTFORM %"[199] 休憩", 18, LEFT%
PRINT 　
	PRINTFORM %"[200] セーブ", 18, LEFT%
PRINT 　
	PRINTFORML %"[300] ロード", 18, LEFT%
PRINT 　
	PRINTFORM %"[777] コンフィグ", 18, LEFT%
PRINT 　
	PRINTFORML %"[888] 通信", 18, LEFT%

FONTREGULAR
SETFONT

;下二重仕切り線
;SETFONT "ARIEL BLACK"
DRAWLINEFORM %UNICODE(0x2550)%
;SETFONT

